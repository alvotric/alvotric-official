# Copy to .env.local for local development. Never commit real secrets.
# Everything here is public (NEXT_PUBLIC_*) because this site is a static export.

# Production origin, no trailing slash. REQUIRED for production builds
# (canonical URLs, Open Graph, sitemap). Leave unset locally.
NEXT_PUBLIC_SITE_URL=

# Optional. Leave empty until a real, monitored business address exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Overrides the Alvo destination in content/site.config.ts
NEXT_PUBLIC_ALVO_URL=
